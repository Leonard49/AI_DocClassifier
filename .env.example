# ============================================================
# AI_DocClassifier — 五人并行 Worker 配置模板
# 用法: copy .env.example .env 后填写下方「必填项」
# ============================================================

# --- 必填项（每人不同，请勿共用） ---
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 单次运行仍可用（兼容旧方式）:
SCAN_ROOT_TOKEN=
# SCAN_FOLDER_NAME=

# 推荐：共享源文件夹清单（token + 分工），见 scan_folders.example.json
# 复制为 scan_folders.json，或放到共享盘：
SCAN_FOLDERS_FILE=scan_folders.json
# SCAN_FOLDERS_FILE=\\HF-D-006494B\shared_db\scan_folders.json
# 无 CLI 且未设 SCAN_ROOT_TOKEN 时，默认跑 assignee==WORKER_ID 的全部 enabled 文件夹

TARGET_PARENT_TOKEN=
# TARGET_ROOT_NAME=

LLM_API_KEY=

# --- 必填项（每人唯一标识，用于共享去重审计；须与 scan_folders.json 的 assignee 一致） ---
WORKER_ID=

# --- 团队共用（SPACE_ID 全组一致，向负责人索取） ---
SPACE_ID=

LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://qlitellm.phicotek.com/v1

# 多人并行去重（五人必须指向同一共享库）
ENABLE_SHARED_DEDUP=true
SHARED_STATE_DB=\\HF-D-006494B\shared_db\shared_copy_state.db
CLAIM_TIMEOUT_MINUTES=30

# 飞书 API — 五人并行（每人独立 App，全局合计约 10 req/s）
ENABLE_CROSS_PROCESS_FEISHU_LIMIT=true
FEISHU_GLOBAL_MAX_PER_SECOND=10
FEISHU_LOCAL_MAX_PER_SECOND=3
FEISHU_API_MAX_RETRIES=5
FEISHU_API_TIMEOUT=90
FEISHU_DOWNLOAD_TIMEOUT=180
FEISHU_RATE_LIMIT_DB=\\HF-D-006494B\shared_db\feishu_rate_limit.db

# 扫描快照增量（Plan B）
FORCE_RESCAN=false
ENABLE_SCAN_SNAPSHOT=true
# 本地运行时数据目录（默认 data/；核心库 → data/core，工具账本 → data/tools）
# DATA_DIR=data
# AUTO_MIGRATE_DATA_DIR=true
# 留空则用默认路径；UNC/绝对路径仍可显式覆盖
# SCAN_SNAPSHOT_DB=
# CLASSIFY_CACHE_DB=
# PROCESSING_PROGRESS_FILE=
# WIKI_SCAN_CACHE_DB=
FULL_SCAN_CALIBRATION_DAYS=30

# 处理行为
USE_CACHE=false
SAVE_PROGRESS=true
SAVE_RUN_LOG=true
LOG_DIR=logs
USE_CLASSIFY_CACHE=true
ENABLE_TAG_ADD=false
# 复制成功后在目标文档开头插入元数据表（产品线=分类 tag1）
ENABLE_METADATA_TABLE=true
METADATA_TABLE_FETCH_AUTHOR=true
# 复制后/回填：在「附件：」前提醒目分隔符（幂等）
ENABLE_ATTACHMENT_SEPARATOR=true
ENABLE_ATTACHMENT_EXTRACT=true

# 文档元数据 → 多维表格（独立工具）
METADATA_BITABLE_MODE=both
METADATA_BITABLE_TITLE=文档元数据汇总
# METADATA_BITABLE_APP_TOKEN=
METADATA_BITABLE_PER_TOKEN_TITLE_TMPL=文档元数据-{id}
METADATA_BITABLE_PER_TOKEN_PARENT=target
# 已废弃：record_id 写入 TOOL_OPS_DB.result_ref；仅兼容导入旧索引
# METADATA_BITABLE_INDEX_DB=
METADATA_USE_LLM_DOC_TYPE=true
METADATA_BITABLE_SKIP_EXISTING=false

# 侧工具：只处理 TARGET 下已分类复制文档；操作账本与主流程去重库分离
# target=TARGET_PARENT_TOKEN（推荐）；scan=源清单（需工具加 --scope scan）
TOOL_DOC_SCOPE=target
# TOOL_OPS_DB=   # 默认 data/tools/tool_ops.db

# 展示标题 → 多维表格（不改 wiki 原标题）
DISPLAY_TITLE_BITABLE_MODE=aggregated
DISPLAY_TITLE_BITABLE_TITLE=文档展示标题
# DISPLAY_TITLE_BITABLE_APP_TOKEN=
DISPLAY_TITLE_BITABLE_PER_TOKEN_TITLE_TMPL=展示标题-{id}
DISPLAY_TITLE_BITABLE_PER_TOKEN_PARENT=target
# DISPLAY_TITLE_BITABLE_INDEX_DB=   # 已废弃，见 TOOL_OPS_DB
DISPLAY_TITLE_USE_LLM_PURPOSE=true
DISPLAY_TITLE_SKIP_EXISTING=false
# 按展示标题格式重命名 TARGET 副本标题（不改 SCAN 源）
DISPLAY_TITLE_RENAME_SKIP_EXISTING=false

# 源 → TARGET 单向内容刷新（保留整理标题；旧副本移入废弃夹）
REFRESH_TARGET_SKIP_UNCHANGED=true
REFRESH_TARGET_OBSOLETE_FOLDER=_已废弃_源刷新

# 副本增强回填（metadata_table / attachment_separator 分 op 记入 TOOL_OPS_DB）
ENRICHMENT_SKIP_EXISTING=false

# 性能（五人并发推荐值：降低单进程并发，避免打满飞书/LLM）
READ_WORKERS=2
CLASSIFY_WORKERS=3
LLM_MAX_RETRIES=6
LLM_REQUEST_TIMEOUT=120
PROGRESS_INTERVAL=10

# Classification quality + folder rollover
OTHERS_RATIO_FAIL_THRESHOLD=0.15
ENABLE_FOLDER_ROLLOVER=true
# FOLDER_ROLLOVER_DB=\\HF-D-006494B\shared_db\folder_rollover_state.db
# MAX_DOCUMENTS=0
# CLASSIFY_MAX_CHARS=3000
# CLASSIFY_VERBOSE=false
