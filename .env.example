# ============================================================
# AI_DocClassifier — 五人并行 Worker 配置模板
# 用法: copy .env.example .env 后填写下方「必填项」
# ============================================================

# --- 必填项（每人不同，请勿共用） ---
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 单次运行仍可用（兼容旧方式）:
SCAN_ROOT_TOKEN=
# SCAN_FOLDER_NAME=

# 推荐：共享源文件夹清单（token + 分工），见 scan_folders.example.json
# 复制为 scan_folders.json，或放到共享盘：
SCAN_FOLDERS_FILE=scan_folders.json
# SCAN_FOLDERS_FILE=\\HF-D-006494B\shared_db\scan_folders.json
# 无 CLI 且未设 SCAN_ROOT_TOKEN 时，默认跑 assignee==WORKER_ID 的全部 enabled 文件夹

TARGET_PARENT_TOKEN=
# TARGET_ROOT_NAME=

LLM_API_KEY=

# --- 必填项（每人唯一标识，用于共享去重审计；须与 scan_folders.json 的 assignee 一致） ---
WORKER_ID=

# --- 团队共用（SPACE_ID 全组一致，向负责人索取） ---
SPACE_ID=

LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://qlitellm.phicotek.com/v1

# 多人并行去重（五人必须指向同一共享库）
ENABLE_SHARED_DEDUP=true
SHARED_STATE_DB=\\HF-D-006494B\shared_db\shared_copy_state.db
CLAIM_TIMEOUT_MINUTES=30

# 飞书 API — 五人并行（每人独立 App，全局合计约 10 req/s）
ENABLE_CROSS_PROCESS_FEISHU_LIMIT=true
FEISHU_GLOBAL_MAX_PER_SECOND=10
FEISHU_LOCAL_MAX_PER_SECOND=3
FEISHU_API_MAX_RETRIES=5
FEISHU_API_TIMEOUT=90
FEISHU_DOWNLOAD_TIMEOUT=180
FEISHU_RATE_LIMIT_DB=\\HF-D-006494B\shared_db\feishu_rate_limit.db

# 扫描快照增量（Plan B）
FORCE_RESCAN=false
ENABLE_SCAN_SNAPSHOT=true
SCAN_SNAPSHOT_DB=scan_snapshot.db
FULL_SCAN_CALIBRATION_DAYS=30

# 处理行为
USE_CACHE=false
SAVE_PROGRESS=true
SAVE_RUN_LOG=true
LOG_DIR=logs
USE_CLASSIFY_CACHE=true
ENABLE_TAG_ADD=false
ENABLE_ATTACHMENT_EXTRACT=true

# 性能（五人并发推荐值：降低单进程并发，避免打满飞书/LLM）
READ_WORKERS=2
CLASSIFY_WORKERS=3
LLM_MAX_RETRIES=6
LLM_REQUEST_TIMEOUT=120
PROGRESS_INTERVAL=10

# Classification quality + folder rollover
# Warn (do not abort) when Others / classified exceeds this ratio; 0 disables
OTHERS_RATIO_FAIL_THRESHOLD=0.15
ENABLE_FOLDER_ROLLOVER=true
# FOLDER_ROLLOVER_DB=\\HF-D-006494B\shared_db\folder_rollover_state.db
# MAX_DOCUMENTS=0
# CLASSIFY_MAX_CHARS=3000
# CLASSIFY_VERBOSE=false

# 文档元数据 → 多维表格（独立工具，不改 main 复制流程）
# 飞书 App 需开通：bitable:app、wiki:wiki；作者名需联系人只读权限
# mode: aggregated=仅汇总表 | per-token=按扫描 token 分表 | both=两者都写
METADATA_BITABLE_MODE=both
METADATA_BITABLE_TITLE=文档元数据汇总
# METADATA_BITABLE_APP_TOKEN=   # 已有汇总表 app_token 时可填，跳过创建
METADATA_BITABLE_PER_TOKEN_TITLE_TMPL=文档元数据-{id}
# 分表挂载：target=与汇总同级(--parent-token/TARGET) | source=各扫描根目录下
METADATA_BITABLE_PER_TOKEN_PARENT=target
METADATA_BITABLE_INDEX_DB=metadata_bitable_index.db
METADATA_USE_LLM_DOC_TYPE=true
